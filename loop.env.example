# Loop settings, read by every script in scripts/ (see scripts/loopenv.py).
# Copy to loop.env (git-ignored) and fill in. A variable set in the environment wins.
# Secrets never go here: tokens stay in the publisher's own environment or keychain.

# loop state folder, outside every repo (required)
STATE_DIR=

# roadmap clone: upstream = DrBradStanfield/roadmap, origin = the fork (required)
WORKDIR=

# GitHub login that owns the fork (required)
GH_FORK_OWNER=

# comma-separated owner names who may start, stop or aim the loop (required)
OWNERS=

# comma-separated GitHub logins whose actions count as addressed (required)
MAINTAINER_LOGINS=

# command that starts the Coach as a separate agent (required)
COACH_CMD=

# agent CLI that takes a prompt as its last argument, for loop.py run-role, with a turn budget long enough for a Bug fixer's gates (e.g. claude -p --max-turns 400, or hermes chat --oneshot --max-turns 400 -q) (required)
ROLE_CMD=

# comma-separated variable NAMES the agent CLI needs for its model login; never GitHub or SSH
# ROLE_PASS=

# pinned fuck-my-shit-mountain skill folder (finder fmsm)
# FMSM_SKILL_DIR=

# pinned Trail of Bits skills clone (finder trail-of-bits)
# TOB_SKILLS_DIR=

# pinned tech-debt-audit SKILL.md (finder tech-debt-audit)
# TECH_DEBT_SKILL=

# line added to PR bodies naming who runs the loop
# ATTRIBUTION=

# 2 or 3 maintainer-requested repair rounds (default 3)
# REPAIR_CAP=

# an automated session ends after this many days (default 14)
# SESSION_MAX_DAYS=

# an automated session ends after this many rounds (default 10)
# SESSION_MAX_ROUNDS=

# default DrBradStanfield/roadmap
# UPSTREAM_REPO=

# default upstream
# UPSTREAM_REMOTE=

# default origin
# PUSH_REMOTE=

# comma-separated test files known to be flaky
# KNOWN_FLAKY=

# publish driver waits while load average is above this
# DRIVER_MAX_LOAD=

# full suite timeout in minutes (default 45)
# SUITE_TIMEOUT_MIN=

# test workers for the full suite (default 4)
# SUITE_MAX_WORKERS=

# secret scanner command (default gitleaks)
# GITLEAKS_BIN=

# command prefix that keeps the machine awake; empty for none
# KEEP_AWAKE=

# folder with the node binary CI uses
# NODE_BIN_DIR=

# extra PATH entries for the suite
# EXTRA_PATH=

# 1 allows force-with-lease repair pushes (default off)
# ALLOW_FORCE_WITH_LEASE=

# Coach keeps watching this many minutes after activity (default 30)
# COOLDOWN_MIN=

# a begun agent counts as working this long (default 120)
# ACTIVITY_TTL_MIN=

# files whose change counts as activity for the Coach
# WATCH_FILES=

# non-empty: watch.py tick always prints
# WATCH_VERBOSE=

# path to the OCR pipeline JSON config
# OCR_PIPELINE_CONFIG=

# OCR pipeline: base folder (or set it in the OCR JSON config)
# OCR_BASE_DIR=

# OCR pipeline: pipeline state folder
# OCR_PIPELINE_DIR=

# OCR pipeline: roadmap worktree to scan
# ROADMAP_WORKTREE=

# OCR pipeline: upstream branch (default main)
# UPSTREAM_BRANCH=

# OCR pipeline: the ocr command
# OCR_BIN=

# OCR pipeline: round folder
# ROUND_DIR=

# OCR pipeline: fixes folder
# FIXES_DIR=

# OCR pipeline: path to scripts/publish/driver.py
# PUBLISH_DRIVER=

# command that receives notices on stdin
# NOTIFY_CMD=
